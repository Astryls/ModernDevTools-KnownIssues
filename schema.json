{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Modern Dev Tools community known issues",
  "type": "object",
  "required": ["schemaVersion", "issues"],
  "properties": {
    "schemaVersion": { "type": "integer" },
    "updated": { "type": "string" },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "explanation", "fix", "match"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "title": { "type": "string" },
          "explanation": { "type": "string" },
          "fix": { "type": "string" },
          "severity": { "type": "string", "enum": ["info", "low", "moderate", "high", "critical"] },
          "url": { "type": "string" },
          "reportedBy": { "type": "string" },
          "verified": { "type": "boolean" },
          "match": {
            "type": "object",
            "properties": {
              "exceptionTypes": { "type": "array", "items": { "type": "string" } },
              "keywords": { "type": "array", "items": { "type": "string" } },
              "regexes": { "type": "array", "items": { "type": "string" } },
              "namespaces": { "type": "array", "items": { "type": "string" } },
              "packageIds": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    }
  }
}
